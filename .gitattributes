# Handle line endings automatically for files detected as text 
# and force them to LF when committed to the repo.
* text=auto eol=lf

# Explicitly declare files that must always be LF (scripts)
*.sh      text eol=lf
*.py      text eol=lf
*.js      text eol=lf
*.ts      text eol=lf
# Denote files that are binary and should not be touched
*.png     binary
*.jpg     binary